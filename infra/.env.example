# Copy to .env and fill in every value. Never commit .env.
# One line per variable. Comments explain what each is for and where it comes from.

# ---------------------------------------------------------------------------
# Public hostname and TLS
# ---------------------------------------------------------------------------
# DNS name that points at the EC2 elastic IP. Caddy requests a certificate for it.
N8N_HOST=n8n.example-dental.com

# Email that Let's Encrypt uses for certificate expiry notices. Use the client admin's address.
ACME_EMAIL=admin@example-dental.com

# Caddy basic auth in front of the n8n editor. Generate the hash with:
#   docker run --rm caddy:2.10.0 caddy hash-password --plaintext "your-long-password"
CADDY_ADMIN_USER=admin
CADDY_ADMIN_PASSWORD_HASH=replace-with-output-of-caddy-hash-password

# Space-separated CIDRs allowed to reach the n8n editor: our office and the client office.
ALLOWED_ADMIN_IPS=203.0.113.10/32 198.51.100.20/32

# Retell's egress IP. Webhook paths accept requests only from here (plus the admin IPs for testing).
# Source: https://docs.retellai.com/features/secure-webhook
RETELL_EGRESS_IP=100.20.5.228/32

# ---------------------------------------------------------------------------
# n8n core
# ---------------------------------------------------------------------------
# Encrypts credentials stored in n8n's database. Generate once and back it up
# in the practice's password manager. If lost, every stored credential must be re-entered.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# RDS Postgres (n8n's own tables). Created in aws-setup.md.
# ---------------------------------------------------------------------------
# RDS endpoint hostname (private, reachable only from the EC2 security group).
DB_POSTGRESDB_HOST=receptionist-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_POSTGRESDB_PORT=5432
# Database that holds n8n's internal tables. The app tables (db/*.sql) live in the
# separate "receptionist" database (see db/README.md) and are reached through an n8n credential.
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_app
DB_POSTGRESDB_PASSWORD=

# ---------------------------------------------------------------------------
# Practice settings
# ---------------------------------------------------------------------------
# IANA timezone of the practice. Used for n8n cron schedules, slot wording and reminders.
PRACTICE_TZ=America/New_York

# Email of the named front-desk queue owner (docs/access-control.md). 12-booking-queue-notify
# sends "new request, call_id ..." here. No PHI goes in the message body.
QUEUE_OWNER_EMAIL=frontdesk@example-dental.com

# ---------------------------------------------------------------------------
# Retell
# ---------------------------------------------------------------------------
# Retell API key with the webhook badge. Used to verify X-Retell-Signature on every
# incoming tool call and post-call webhook, and to call the Retell SMS / batch-call APIs.
# Rotate from the Retell dashboard if exposed (docs/incident-response.md).
RETELL_API_KEY=

# JSON array of approved Retell agent ids. retell/scripts/audit-config.ts compares the
# live agents against retell/agents/*.json and alerts on any difference.
# Example: ["agent_abc123","agent_def456","agent_ghi789"]
APPROVED_AGENTS_JSON=[]

# Retell agent ids used by n8n workflows 08 and 10 (create-sms-chat). Fill after push-config.
RETELL_SMS_AGENT_ID=
RETELL_OPTOUT_AGENT_ID=

# ---------------------------------------------------------------------------
# NexHealth (Synchronizer API in front of Dentrix)
# ---------------------------------------------------------------------------
# API key from developers.nexhealth.com. Exchanged for a one-hour bearer token
# by POST https://nexhealth.info/authenticates. Use the sandbox key until Phase 6.
NEXHEALTH_API_KEY=
# The practice's NexHealth institution subdomain (sandbox value first, production after Phase 6).
NEXHEALTH_SUBDOMAIN=
# NexHealth numeric location ids for each office. Found via GET /locations.
NEXHEALTH_LOCATION_DOWNTOWN=
NEXHEALTH_LOCATION_NORTHSIDE=

# ---------------------------------------------------------------------------
# Audit log hashing
# ---------------------------------------------------------------------------
# Secret salt for patient_ref = sha256(nexhealth_patient_id || salt) and
# phone_hash = sha256(E.164 phone || salt). Generate once, never change it (changing it
# breaks joins against suppression_list and historic log rows). Store with the encryption key.
#   openssl rand -hex 32
PATIENT_HASH_SALT=
