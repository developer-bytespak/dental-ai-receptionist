# Copy to .env.local for local work, or paste these into the Vercel or Render
# dashboard for a deploy. Nothing here is secret until you fill it in; once you
# do, never commit the filled file. .env is gitignored.

# Postgres connection string. OPTIONAL. Leave it unset and the demo runs on
# PGlite, an embedded Postgres that needs no account, no Docker and no network.
# Set it only when the demo data has to survive a restart (Neon, Supabase,
# Render Postgres). Same SQL either way.
DATABASE_URL=

# Where PGlite keeps its files when DATABASE_URL is unset. Defaults to ./.pgdata.
# On Render use /tmp/pgdata, because the rest of the filesystem is read only on
# some instance types.
PGLITE_DIR=./.pgdata

# SECRET. Retell dashboard, API Keys. Two jobs: the push script authenticates
# with it, and the webhook routes verify the x-retell-signature HMAC with it.
# The key here must be the same key that created the agent, or every webhook
# will be rejected as an invalid signature.
RETELL_API_KEY=

# Public key for the browser call widget, Retell dashboard, same page as the
# API key. Safe to ship to the browser. Needed only for in-browser calls.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=

# The agent id. Printed by: npx tsx retell/push-demo-config.ts
NEXT_PUBLIC_RETELL_AGENT_ID=

# The Retell phone number bound to the agent, in E.164, for example
# +15551234567. Shown on the demo page so the room can dial it.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=

# SECRET. Salt for the one way patient and phone pseudonyms written to the
# audit log, so the log carries no direct identifier. Change it from the
# default before any deploy. Generate one with: openssl rand -hex 32
PATIENT_HASH_SALT=

# Accept unsigned webhooks. Keep it false or unset for a real demo, so the
# signature check runs and the compliance panel shows it passing. Set it to
# true only to drive tests/demo-pipeline.http by hand without a voice call.
ALLOW_UNSIGNED_WEBHOOKS=false
