      "parameters": {
        "jsCode": "// Verifies X-Retell-Signature. Format: \"v=<unix ms>,d=<hex hmac>\"\n// digest = HMAC-SHA256(rawBody + timestamp, RETELL_API_KEY), timestamp must be within 5 minutes,\n// compared in constant time. Source: https://docs.retellai.com/features/secure-webhook\n// Requires: NODE_FUNCTION_ALLOW_BUILTIN=crypto and the Webhook node option \"Raw Body\" (binary property \"data\").\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst sigHeader = String(headers['x-retell-signature'] || '');\nconst apiKey = $env.RETELL_API_KEY || '';\nlet raw;\ntry {\n  raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch (e) {\n  // Fallback only if raw body is unavailable; a re-serialized body may not match the signed bytes.\n  raw = typeof item.json.body === 'string' ? item.json.body : JSON.stringify(item.json.body ?? {});\n}\nlet verified = false;\nlet reason = 'missing_signature';\nif (!apiKey) {\n  reason = 'missing_api_key';\n} else if (sigHeader) {\n  const parts = {};\n  for (const seg of sigHeader.split(',')) {\n    const i = seg.indexOf('=');\n    if (i > 0) parts[seg.slice(0, i).trim()] = seg.slice(i + 1).trim();\n  }\n  const ts = parts.v;\n  const given = parts.d;\n  if (!ts || !given) {\n    reason = 'malformed_signature';\n  } else if (Math.abs(Date.now() - Number(ts)) > 5 * 60 * 1000) {\n    reason = 'stale_timestamp';\n  } else {\n    const expected = crypto.createHmac('sha256', apiKey).update(raw + ts).digest('hex');\n    const a = Buffer.from(expected, 'utf8');\n    const b = Buffer.from(given, 'utf8');\n    verified = a.length === b.length && crypto.timingSafeEqual(a, b);\n    reason = verified ? 'ok' : 'digest_mismatch';\n  }\n}\nlet body = item.json.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nreturn [{ json: { verified, reason, body: body ?? {}, headers } }];\n"
      },
