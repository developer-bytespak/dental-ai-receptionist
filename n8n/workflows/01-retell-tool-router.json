        "jsCode": "// Retell custom-function payload: { call: {...}, name: '<function>', args: {...} }\nconst b = $json.body || {};\nconst call = b.call || {};\nconst dyn = call.retell_llm_dynamic_variables || {};\nconst envJson = (k) => { try { return JSON.parse($env[k] || '{}'); } catch (e) { return {}; } };\nconst locMap = envJson('NEXHEALTH_LOCATION_IDS');      // { \"downtown\": 123, \"northside\": 456 }\nconst numMap = envJson('RETELL_LOCATION_NUMBERS');     // { \"+14155550100\": \"downtown\", ... }\nconst location = dyn.location || numMap[call.to_number] || Object.keys(locMap)[0] || 'unknown';\nreturn [{ json: {\n  name: String(b.name || ''),\n  call_id: call.call_id || null,\n  args: (b.args && typeof b.args === 'object') ? b.args : {},\n  location,\n  location_id: locMap[location] || null,\n  from_number: call.from_number || null,\n  to_number: call.to_number || null,\n} }];\n"
