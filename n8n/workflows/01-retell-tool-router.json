    {
      "parameters": {
        "jsCode": "// ---- shared helpers (duplicated in each workflow on purpose: n8n Code nodes cannot import) ----\nconst crypto = require('crypto');\nconst TZ = $env.PRACTICE_TZ || 'America/New_York';\nconst SALT = $env.PATIENT_HASH_SALT || '';\nconst envJson = (k) => { try { return JSON.parse($env[k] || '{}'); } catch (e) { return {}; } };\nconst sha256 = (s) => crypto.createHash('sha256').update(String(s)).digest('hex');\nconst patientRef = (id) => (id === null || id === undefined || id === '') ? null : sha256(String(id) + SALT);\nconst fmt = (d, opts) => new Intl.DateTimeFormat('en-US', Object.assign({ timeZone: TZ }, opts)).format(d);\nconst ordinal = (n) => n + ((n % 10 === 1 && n !== 11) ? 'st' : (n % 10 === 2 && n !== 12) ? 'nd' : (n % 10 === 3 && n !== 13) ? 'rd' : 'th');\nconst sayWhen = (iso) => { const d = new Date(iso); return fmt(d, { weekday: 'long' }) + ' the ' + ordinal(Number(fmt(d, { day: 'numeric' }))) + ' at ' + fmt(d, { hour: 'numeric', minute: '2-digit' }); };\nconst providerFirst = (id, fallbackName) => {\n  const names = envJson('NEXHEALTH_PROVIDER_NAMES');\n  if (id !== null && id !== undefined && names[String(id)]) return names[String(id)];\n  if (fallbackName) { const parts = String(fallbackName).replace(/^(dr\\.?|doctor)\\s+/i, '').trim().split(/\\s+/); return parts.length ? 'Dr. ' + parts[parts.length - 1] : null; }\n  return null;\n};\nconst e164 = (p) => { if (!p) return null; let d = String(p).replace(/[^\\d+]/g, ''); if (d.startsWith('+')) return d; d = d.replace(/\\D/g, ''); if (d.length === 10) return '+1' + d; if (d.length === 11 && d.startsWith('1')) return '+' + d; return d ? '+' + d : null; };\n// ---- end helpers ----\n\nconst req = $('Normalize request').first().json;\nlet result = Object.assign({}, $json);\nif (result.error && !result.status) { result = { status: 'error' }; }   // sub-workflow threw (Execute Workflow set to continue on error)\nconst pid = result.patient_id || (req.args && req.args.patient_id) || null;\nconst patient_ref = patientRef(pid);\nconst appointment_ref = result.appointment_id ? String(result.appointment_id)\n  : (req.args && req.args.appointment_id ? String(req.args.appointment_id) : null);\nconst status = String(result.status || 'ok');\nconst outcome = ['not_found', 'queued', 'error', 'denied'].includes(status) ? status : 'ok';\nreturn [{ json: {\n  actor: 'retell-agent',\n  action: req.name,\n  call_id: req.call_id,\n  patient_ref,\n  appointment_ref,\n  location: req.location,\n  outcome,\n  detail: { fn: req.name, status },\n  result,\n} }];\n"
      },
