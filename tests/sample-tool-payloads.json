{
  "_readme": [
    "Example Retell custom-function requests and the responses the n8n tool router returns.",
    "Retell POSTs to https://n8n.<client-domain>/webhook/retell/tool with Content-Type: application/json",
    "and X-Retell-Signature: v=<unix ms>,d=<hex HMAC-SHA256(raw_body + timestamp, RETELL_API_KEY)>.",
    "Body shape (source: docs.retellai.com custom function): { name, call, args }. The call object is",
    "abbreviated here; the real one includes the live transcript and more fields. Verify the signature",
    "on the raw body string, not on re-serialised JSON. Reject with 401 if it fails or is older than 5 minutes.",
    "Responses must stay under 500 characters and must never include phone, email, address, codes or balances.",
    "All names, numbers and ids below are fake."
  ],
  "common_request_headers": {
    "Content-Type": "application/json",
    "X-Retell-Signature": "v=1757850000000,d=3f1b6c0f8e6d4a2b9c7e5d1a0f3b8c6e2d4a7b9c1e3f5d7a9b1c3e5f7a9b1c3d"
  },
  "call_object_example": {
    "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
    "agent_id": "agent_reception_inbound_01",
    "call_type": "phone_call",
    "direction": "inbound",
    "from_number": "+15550100001",
    "to_number": "+15550200001",
    "call_status": "ongoing",
    "start_timestamp": 1757849900000,
    "retell_llm_dynamic_variables": {
      "practice_name": "Example Dental",
      "location": "downtown"
    }
  },
  "functions": {
    "find_patient": {
      "request": {
        "name": "find_patient",
        "call": { "$ref": "call_object_example" },
        "args": {
          "full_name": "Jane Testcase",
          "date_of_birth": "1980-01-15",
          "location": "downtown"
        }
      },
      "response_match": {
        "status": "ok",
        "patient_id": "415",
        "first_name": "Jane"
      },
      "response_not_found": {
        "status": "not_found"
      },
      "response_pms_error": {
        "status": "error",
        "say": "I'm having trouble reaching our scheduling system. I'll send this to our team and they'll confirm with you within the hour."
      },
      "log_row": {
        "actor": "retell-agent",
        "action": "find_patient",
        "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
        "patient_ref": "sha256(415 || PATIENT_HASH_SALT)",
        "location": "downtown",
        "outcome": "ok | not_found | error",
        "detail": { "matches": 1 }
      }
    },
    "get_slots": {
      "request": {
        "name": "get_slots",
        "call": { "$ref": "call_object_example" },
        "args": {
          "patient_id": "415",
          "appointment_type": "cleaning",
          "time_preference": "morning",
          "provider_preference": null,
          "location": "downtown"
        }
      },
      "response": {
        "status": "ok",
        "slots": [
          { "id": "s1", "say": "Tuesday the 16th at 9:20 with Dr. Patel" },
          { "id": "s2", "say": "Wednesday the 17th at 10:40 with Dr. Patel" },
          { "id": "s3", "say": "Thursday the 18th at 8:00 with Dr. Kim" }
        ]
      },
      "response_none": {
        "status": "ok",
        "slots": [],
        "say": "I don't see any morning openings in the next two weeks. Would an afternoon work, or should I have our team call you?"
      },
      "note": "The slot map (id to NexHealth time, provider_id, operatory_id, appointment_type_id) is cached in workflow static data keyed by call_id. Only the id and the spoken text go back to Retell.",
      "log_row": {
        "actor": "retell-agent",
        "action": "get_slots",
        "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
        "patient_ref": "sha256(415 || PATIENT_HASH_SALT)",
        "location": "downtown",
        "outcome": "ok",
        "detail": { "offered": 3, "type": "cleaning", "pref": "morning" }
      }
    },
    "book_appointment": {
      "request": {
        "name": "book_appointment",
        "call": { "$ref": "call_object_example" },
        "args": {
          "patient_id": "415",
          "slot_id": "s1",
          "location": "downtown"
        }
      },
      "response_booked": {
        "status": "booked",
        "say": "You're booked for Tuesday the 16th at 9:20 with Dr. Patel at our downtown office."
      },
      "response_queued": {
        "status": "queued",
        "say": "I've sent that to our team and they'll confirm with you by text or call within the hour."
      },
      "log_row": {
        "actor": "retell-agent",
        "action": "book_appointment",
        "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
        "patient_ref": "sha256(415 || PATIENT_HASH_SALT)",
        "appointment_ref": "sha256(1822 || PATIENT_HASH_SALT)",
        "location": "downtown",
        "outcome": "ok | queued",
        "detail": { "slot": "s1", "type": "cleaning" }
      }
    },
    "reschedule_appointment": {
      "request": {
        "name": "reschedule_appointment",
        "call": { "$ref": "call_object_example" },
        "args": {
          "patient_id": "416",
          "appointment_id": "1822",
          "slot_id": "s2",
          "location": "downtown"
        }
      },
      "response_rescheduled": {
        "status": "rescheduled",
        "say": "Done. Your appointment is now Wednesday the 17th at 10:40 with Dr. Patel at our downtown office."
      },
      "response_queued": {
        "status": "queued",
        "say": "I've sent that to our team and they'll confirm with you by text or call within the hour."
      },
      "log_row": {
        "actor": "retell-agent",
        "action": "reschedule_appointment",
        "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
        "patient_ref": "sha256(416 || PATIENT_HASH_SALT)",
        "appointment_ref": "sha256(1822 || PATIENT_HASH_SALT)",
        "location": "downtown",
        "outcome": "ok | queued",
        "detail": { "slot": "s2" }
      }
    },
    "cancel_appointment": {
      "request": {
        "name": "cancel_appointment",
        "call": { "$ref": "call_object_example" },
        "args": {
          "patient_id": "416",
          "appointment_id": "1822",
          "location": "downtown"
        }
      },
      "response_cancelled": {
        "status": "cancelled",
        "say": "Your appointment on Wednesday the 17th at 10:40 is cancelled. Call us any time to rebook."
      },
      "response_queued": {
        "status": "queued",
        "say": "I've sent that to our team and they'll confirm with you by text or call within the hour."
      },
      "log_row": {
        "actor": "retell-agent",
        "action": "cancel_appointment",
        "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
        "patient_ref": "sha256(416 || PATIENT_HASH_SALT)",
        "appointment_ref": "sha256(1822 || PATIENT_HASH_SALT)",
        "location": "downtown",
        "outcome": "ok | queued",
        "detail": {}
      }
    },
    "confirm_appointment": {
      "request": {
        "name": "confirm_appointment",
        "call": { "$ref": "call_object_example" },
        "args": {
          "patient_id": "416",
          "appointment_id": "1822",
          "location": "downtown"
        }
      },
      "response_confirmed": {
        "status": "confirmed",
        "say": "Thanks, you're confirmed for Wednesday the 17th at 10:40. See you then."
      },
      "response_queued": {
        "status": "queued",
        "say": "I've noted that for our team. They'll follow up if anything is needed."
      },
      "log_row": {
        "actor": "retell-agent",
        "action": "confirm_appointment",
        "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
        "patient_ref": "sha256(416 || PATIENT_HASH_SALT)",
        "appointment_ref": "sha256(1822 || PATIENT_HASH_SALT)",
        "location": "downtown",
        "outcome": "ok | queued",
        "detail": {}
      }
    },
    "queue_request": {
      "request": {
        "name": "queue_request",
        "call": { "$ref": "call_object_example" },
        "args": {
          "reason": "new_patient",
          "location": "northside",
          "patient_id": null,
          "appointment_type": "exam",
          "time_preference": "afternoon",
          "callback_number": "+15550100009"
        }
      },
      "response": {
        "status": "queued",
        "say": "I've sent that to our team and they'll confirm with you by text or call within the hour."
      },
      "queue_row": {
        "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
        "patient_ref": null,
        "location": "northside",
        "reason": "new_patient",
        "requested": { "type": "exam", "pref": "afternoon", "callback_last4": "0009" }
      },
      "log_row": {
        "actor": "retell-agent",
        "action": "queue_request",
        "call_id": "call_9f1a2b3c4d5e6f7a8b9c0d1e2f",
        "patient_ref": null,
        "location": "northside",
        "outcome": "queued",
        "detail": { "reason": "new_patient" }
      },
      "note": "The full callback number is used only to notify staff through the queue page and is never written to a table. Only the last four digits are stored."
    }
  },
  "error_responses": {
    "bad_signature": {
      "http_status": 401,
      "body": { "status": "denied" },
      "log_row": { "actor": "n8n", "action": "tool_router", "outcome": "denied", "detail": { "reason": "bad_signature" } }
    },
    "unknown_function": {
      "http_status": 400,
      "body": { "status": "error", "say": "Sorry, I can't do that. Say staff to reach a person." }
    }
  }
}
